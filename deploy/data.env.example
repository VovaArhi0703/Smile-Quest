# Copy to deploy/data.env on the data VM and replace every example value.
# Keep POSTGRES_PASSWORD URL-safe (letters/digits) because it is used in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_CHARACTER_VALUE
PHOTO_SIGNING_KEY=REPLACE_WITH_ANOTHER_RANDOM_64_CHARACTER_VALUE
DATA_PRIVATE_IP=10.0.0.10
EXERCISE_PRIVATE_IP=10.0.0.11
API_DOMAIN=api.example.ru
EXERCISE_DOMAIN=exercise.example.ru
